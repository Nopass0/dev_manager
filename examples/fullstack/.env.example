# Единый .env для проекта fullstack.
# Скопируйте в .env и заполните. dm env sync раскидает по сервисам.

# --- Глобальные (попадают во все сервисы) ---
LOG_LEVEL=info

# --- API (Rust) ---
[api]
DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
PORT=8080
RUST_LOG=api=debug,info

# --- Web (Vite) ---
[web]
VITE_API_URL=http://localhost:8080
